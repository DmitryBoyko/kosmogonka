config_version=5

[application]
config/name="Космогонка"
config/description="Одиннадцать планет, дети-космонавты и весёлые межпланетные гонки."
config/version="0.16.15"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://assets/branding/app-icon.png"
boot_splash/image="res://assets/branding/launch-splash-native.png"
boot_splash/bg_color=Color(0.0353,0.0667,0.1529,1)
boot_splash/show_image=true
boot_splash/fullsize=true
boot_splash/stretch_mode=4
boot_splash/use_filter=true
boot_splash/minimum_display_time=0

[autoload]
Profile="*res://scripts/profile.gd"
SceneDisposal="*res://scripts/scene_disposal.gd"

[display]
window/size/viewport_width=540
window/size/viewport_height=960
window/size/window_width_override=486
window/size/window_height_override=864
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/vram_compression/import_etc2_astc=true
lights_and_shadows/directional_shadow/size.mobile=1024
environment/defaults/default_clear_color=Color(0.028,0.035,0.12,1)
anti_aliasing/quality/msaa_3d=1
limits/opengl/max_renderable_lights=8
limits/opengl/max_lights_per_object=4

[input_devices]
pointing/emulate_touch_from_mouse=false

[gui]
theme/custom_font="res://assets/fonts/RussoOne-Regular.ttf"
