extends Node
## Independent buses/volume from ArcadaLittleTruck; clips generated by tools/generate_audio.py.
var pool: Array[AudioStreamPlayer] = []
var voice: AudioStreamPlayer
var music: AudioStreamPlayer
var engine: AudioStreamPlayer
var tracks: Array[String] = []
var track_index := 0
var cooldown := 0.0
var last_voice := ""
var streams: Dictionary = {}

func _ready() -> void:
	for i in 10:
		var p := AudioStreamPlayer.new()
		p.bus = "Effects"
		add_child(p)
		pool.append(p)
	voice = AudioStreamPlayer.new()
	voice.bus = "Voices"
	add_child(voice)
	music = AudioStreamPlayer.new()
	music.bus = "Music"
	add_child(music)
	music.finished.connect(next_track)
	engine = AudioStreamPlayer.new()
	engine.bus = "Effects"
	engine.volume_db = -14
	add_child(engine)
	engine.finished.connect(func():
		if bool(engine.get_meta("active", false)): engine.play())
	scan_music("res://assets/music")
	if not tracks.is_empty(): next_track()

func scan_music(path: String) -> void:
	# Empty source folders are not present in an exported PCK.
	if not DirAccess.dir_exists_absolute(path): return
	for file in DirAccess.get_files_at(path):
		if file.get_extension().to_lower() in ["ogg", "mp3", "wav"]: tracks.append(path.path_join(file))
	for dir in DirAccess.get_directories_at(path): scan_music(path.path_join(dir))
	tracks.sort()

func get_clip(key: String) -> AudioStream:
	if not streams.has(key): streams[key] = load("res://assets/audio/" + key + ".wav")
	return streams[key]

func sfx(key: String, pitch: float = 1.0) -> void:
	for p in pool:
		if not p.playing:
			p.stream = get_clip(key)
			p.pitch_scale = pitch
			p.volume_db = -4
			p.play()
			return

func vocal(event: String, girl: bool, force: bool = false) -> void:
	if not force and (cooldown > 0 or voice.playing): return
	var variant := randi_range(0, 2)
	var key := ("girl" if girl else "boy") + "_" + event + "_" + str(variant)
	if key == last_voice: key = key.left(-1) + str((variant + 1) % 3)
	last_voice = key
	voice.stream = get_clip(key)
	voice.play()
	cooldown = 2.3

func advance(dt: float) -> void:
	cooldown = maxf(0, cooldown - dt)

func set_engine(active: bool) -> void:
	engine.set_meta("active", active)
	if active and not engine.playing:
		engine.stream = get_clip("engine")
		engine.play()
	elif not active: engine.stop()

func set_paused(value: bool) -> void:
	for p in pool: p.stream_paused = value
	voice.stream_paused = value
	engine.stream_paused = value
	music.stream_paused = value

func next_track() -> void:
	if tracks.is_empty(): return
	var path := tracks[track_index % tracks.size()]
	track_index += 1
	music.stream = load(path)
	music.play()
